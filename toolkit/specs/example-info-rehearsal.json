{
 "length": 35,
 "sound": "vyzee",
 "lines": [],
 "text": [
  {
   "from": 0,
   "big": "You've had that fight 40 times. In your head.",
   "y": 780,
   "size": 62,
   "to": 5
  },
  {
   "from": 5,
   "big": "And felt the sting every single time.",
   "y": 780,
   "size": 66,
   "to": 10
  },
  {
   "from": 10,
   "big": "The real one hasn't even happened yet.",
   "y": 780,
   "size": 66,
   "to": 15
  },
  {
   "from": 15,
   "big": "And when it does, it's almost always smaller.",
   "y": 780,
   "size": 62,
   "to": 20
  },
  {
   "from": 20,
   "big": "Your mind makes you pay for pain in advance.",
   "y": 780,
   "size": 62,
   "to": 25
  },
  {
   "from": 25,
   "big": "So what part of it is actually yours?",
   "y": 780,
   "size": 66,
   "to": 31
  },
  {
   "from": 31,
   "big": "Split it in two.",
   "y": 780,
   "size": 80,
   "to": 37
  },
  {
   "from": 37,
   "big": "Yours: your effort. Your words. Your response.",
   "y": 780,
   "size": 62,
   "to": 43
  },
  {
   "from": 43,
   "big": "Not yours: their reaction. The outcome.",
   "y": 780,
   "size": 64,
   "to": 49
  },
  {
   "from": 49,
   "big": "Do your part. Let the rest go.",
   "y": 780,
   "size": 70,
   "to": 55
  },
  {
   "from": 55,
   "big": "Live it once. Not forty times.",
   "y": 780,
   "size": 72,
   "gold": true
  }
 ],
