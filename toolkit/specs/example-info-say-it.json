 "sound": "vyzee",
 "lines": [],
 "text": [
  {
   "from": 0,
   "big": "You said it once. Then forgot it by Tuesday.",
   "y": 780,
   "size": 62,
   "to": 5
  },
  {
   "from": 5,
   "big": "A belief you say once is just a sentence.",
   "y": 780,
   "size": 62,
   "to": 10
  },
  {
   "from": 10,
   "big": "It won't hold on the days nobody's watching.",
   "y": 780,
   "size": 62,
   "to": 15
  },
  {
   "from": 15,
   "big": "Your autopilot runs most of your day.",
   "y": 780,
   "size": 66,
   "to": 20
  },
  {
   "from": 20,
   "big": "And it believes whatever it hears most.",
   "y": 780,
   "size": 66,
   "to": 25
  },
  {
   "from": 25,
   "big": "So what are you telling yourself on repeat?",
   "y": 780,
   "size": 64,
   "to": 31
  },
  {
   "from": 31,
   "big": "Choose the sentence.",
   "y": 780,
   "size": 80,
   "to": 37
  },
  {
   "from": 37,
   "big": "Make it true. Make it short. Make it yours.",
   "y": 780,
   "size": 62,
   "to": 43
  },
  {
   "from": 43,
   "big": "Say it every morning. Say it every night.",
   "y": 780,
   "size": 64,
   "to": 49
  },
  {
   "from": 49,
   "big": "Out loud. Even when it feels stupid.",
   "y": 780,
   "size": 68,
   "to": 55
  },
  {
   "from": 55,
   "big": "Say it until it's true.",
   "y": 780,
   "size": 76,
   "gold": true
  }
 ],
