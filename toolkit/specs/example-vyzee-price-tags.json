 "voice": "am_michael",
 "lines": [
  {"at": 0.12, "text": "You can't afford your dreams."},
  {"beat": 4,  "text": "And it's not about money."},
  {"beat": 8,  "text": "You priced the destination, in loving detail."},
  {"beat": 16, "text": "But you never turned the tag around."},
  {"beat": 25, "text": "Want to see what it really costs?"},
  {"beat": 31, "text": "Five A M."},
  {"beat": 33, "text": "Your comfort."},
  {"beat": 35, "text": "Your evenings."},
  {"beat": 37, "text": "The friends who need you small."},
  {"beat": 40, "text": "Years where nothing seems to happen."},
  {"beat": 45, "text": "It was always the price. You just never looked."},
  {"beat": 51, "text": "A wish wants it delivered."},
  {"beat": 54, "text": "A desire pays for it."},
  {"beat": 57, "text": "The ones that hurt to pay for, are the only ones that change your life."},
  {"beat": 67, "text": "Cheap wants never cost you anything."},
  {"beat": 71, "text": "That's why they never build anything."}
